        {
          "type": "text-delta",
          "id": "511cfdb6-7798-481d-8bb9-d6252e18d288:text:1",
          "delta": "定，不能据场地清理完毕认"
        },
        {
          "type": "text-delta",
          "id": "511cfdb6-7798-481d-8bb9-d6252e18d288:text:1",
